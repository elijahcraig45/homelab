[Unit]
Description=Tailscale UDP GRO tuning for subnet routing
After=network-online.target
Wants=network-online.target
Before=tailscaled.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/sbin/ethtool -K eno1 rx-udp-gro-forwarding on rx-gro-list off

[Install]
WantedBy=multi-user.target
