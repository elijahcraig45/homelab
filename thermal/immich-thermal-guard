#!/bin/bash
# Closed-loop CPU governor for the Immich containers.
#
# It holds a TEMPERATURE, not a throughput. The quotas in
# docker-compose.override.yml are only a starting ceiling; this trims below
# them until the SoC sits under HOT (see /etc/immich-thermal.conf) and gives
# CPU back below COOL. Lowering HOT makes the backfill slower, never broken.
#
# Why a loop and not a fixed quota: a fixed quota is not stable across seasons
# or across whatever else the box happens to be doing. Measured host baseline
# here is ~1.3 cores (tailscaled ~0.44, mergerfs ~0.20, misc ~0.65) BEFORE
# Immich gets any, and tailscaled's share depends on whether a phone is
# uploading through the tunnel. A fixed number cannot track that; this can.
#
# Runs every 2 min from immich-thermal-guard.timer. Idempotent - it only calls
# `docker update` when a value actually changes, so a quiet loop is free.
#
# Usage: immich-thermal-guard [--apply-now]
set -euo pipefail

# Paths and the docker binary are overridable ONLY so the control loop can be
# exercised off-box by tests/guard-test.sh. Defaults are the real ones.
STATEDIR=${IMMICH_GUARD_STATEDIR:-/var/lib/immich-thermal}
TEMPFILE=${IMMICH_GUARD_TEMPFILE:-/sys/class/thermal/thermal_zone0/temp}
SWAPS=${IMMICH_GUARD_SWAPS:-/proc/swaps}
DOCKER=${IMMICH_GUARD_DOCKER:-docker}
NTFY=${IMMICH_GUARD_NTFY:-/usr/local/bin/ntfy-send}
CONF=${IMMICH_GUARD_CONF:-/etc/immich-thermal.conf}
ML=immich_machine_learning
SRV=immich_server

# Defaults, overridden by $CONF. Keep in sync with the shipped conf file.
HOT=76.0; COOL=70.0; STEP=0.25; HOT_STREAK_NEEDED=2
DAY_ML=0.6; DAY_SRV=1.2; NIGHT_ML=1.2; NIGHT_SRV=0.6
ML_FLOOR=0.25; SRV_FLOOR=0.50; CPUSET="0-2"
SWAP_WARN_MIB=192; SWAP_CLEAR_MIB=384
# shellcheck source=/dev/null
[ -r "$CONF" ] && . "$CONF"

APPLY_NOW=0
[ "${1:-}" = "--apply-now" ] && APPLY_NOW=1

# Nothing to do if the stack is down - don't spam the journal.
"$DOCKER" inspect "$ML" "$SRV" >/dev/null 2>&1 || exit 0

running() { [ "$("$DOCKER" inspect -f '{{.State.Running}}' "$1" 2>/dev/null)" = true ]; }
ml_up=1; srv_up=1
running "$ML"  || ml_up=0
running "$SRV" || srv_up=0
[ "$ml_up" = 0 ] && [ "$srv_up" = 0 ] && exit 0

install -d -m 755 "$STATEDIR"
prof=$(cat "$STATEDIR/profile" 2>/dev/null || echo day)
case "$prof" in
  night) ml_target=$NIGHT_ML; srv_target=$NIGHT_SRV ;;
  *)     prof=day; ml_target=$DAY_ML; srv_target=$DAY_SRV ;;
esac

# If one service is stopped (e.g. ML disabled while the backfill catches up on
# thumbnails), hand its share to the other instead of spending adjustments on
# a container that cannot use them. Without this the governor would trim a
# stopped ML first and leave thumbnailGeneration starved at its floor.
budget=$(awk -v a="$ml_target" -v b="$srv_target" 'BEGIN{printf "%.2f", a+b}')
if [ "$ml_up" = 0 ]; then
  srv_target=$budget; ml_target=0
elif [ "$srv_up" = 0 ]; then
  ml_target=$budget; srv_target=0
fi

ml=$(cat "$STATEDIR/ml_cpus"  2>/dev/null || echo "$ml_target")
srv=$(cat "$STATEDIR/srv_cpus" 2>/dev/null || echo "$srv_target")
streak=$(cat "$STATEDIR/hot_streak" 2>/dev/null || echo 0)

temp=$(awk '{printf "%.1f", $1/1000}' "$TEMPFILE")
gt() { awk -v a="$1" -v b="$2" 'BEGIN{exit !(a>b)}'; }
lt() { awk -v a="$1" -v b="$2" 'BEGIN{exit !(a<b)}'; }
sub_() { awk -v a="$1" -v b="$2" -v f="$3" 'BEGIN{v=a-b; if(v<f)v=f; printf "%.2f", v}'; }
add_() { awk -v a="$1" -v b="$2" -v c="$3" 'BEGIN{v=a+b; if(v>c)v=c; printf "%.2f", v}'; }

action="hold"
if gt "$temp" "$HOT"; then
  streak=$((streak + 1))
  if [ "$streak" -ge "$HOT_STREAK_NEEDED" ]; then
    streak=0
    # Trim the service the current profile does NOT favour, first.
    if [ "$prof" = night ]; then first=srv; else first=ml; fi
    [ "$ml_up" = 0 ] && first=srv
    [ "$srv_up" = 0 ] && first=ml
    if [ "$first" = ml ] && [ "$ml_up" = 1 ] && gt "$ml" "$ML_FLOOR"; then
      ml=$(sub_ "$ml" "$STEP" "$ML_FLOOR");    action="trim-ml"
    elif [ "$first" = srv ] && [ "$srv_up" = 1 ] && gt "$srv" "$SRV_FLOOR"; then
      srv=$(sub_ "$srv" "$STEP" "$SRV_FLOOR");  action="trim-server"
    elif [ "$ml_up" = 1 ] && gt "$ml" "$ML_FLOOR"; then
      ml=$(sub_ "$ml" "$STEP" "$ML_FLOOR");    action="trim-ml"
    elif [ "$srv_up" = 1 ] && gt "$srv" "$SRV_FLOOR"; then
      srv=$(sub_ "$srv" "$STEP" "$SRV_FLOOR");  action="trim-server"
    else
      action="at-floor-still-hot"
      # Both at floor and still over HOT with the fan maxed means this is a
      # cooling/ambient problem, not a load problem. Tell someone.
      if [ -x "$NTFY" ] && [ ! -f "$STATEDIR/floor-alerted" ]; then
        "$NTFY" "pihome still hot at CPU floor" \
          "SoC ${temp} C with Immich pinned to ${ML_FLOOR}+${SRV_FLOOR} cores and the fan maxed. Check airflow/dust, or something outside Immich is loading the box." \
          high "fire,warning" || true
        touch "$STATEDIR/floor-alerted"
      fi
    fi
  fi
elif lt "$temp" "$COOL"; then
  streak=0
  rm -f "$STATEDIR/floor-alerted"
  # Give the profile's favoured service its headroom back first.
  if [ "$prof" = night ] && [ "$ml_up" = 1 ] && lt "$ml" "$ml_target"; then
    ml=$(add_ "$ml" "$STEP" "$ml_target");    action="restore-ml"
  elif [ "$prof" != night ] && [ "$srv_up" = 1 ] && lt "$srv" "$srv_target"; then
    srv=$(add_ "$srv" "$STEP" "$srv_target");  action="restore-server"
  elif [ "$ml_up" = 1 ] && lt "$ml" "$ml_target"; then
    ml=$(add_ "$ml" "$STEP" "$ml_target");    action="restore-ml"
  elif [ "$srv_up" = 1 ] && lt "$srv" "$srv_target"; then
    srv=$(add_ "$srv" "$STEP" "$srv_target");  action="restore-server"
  fi
else
  streak=0
fi

# Apply only on change (or when explicitly asked, e.g. after a profile swap).
applied=""
cur_ml=$("$DOCKER" inspect -f '{{.HostConfig.NanoCpus}}' "$ML")
cur_srv=$("$DOCKER" inspect -f '{{.HostConfig.NanoCpus}}' "$SRV")
want_ml=$(awk -v v="$ml" 'BEGIN{printf "%d", v*1000000000}')
want_srv=$(awk -v v="$srv" 'BEGIN{printf "%d", v*1000000000}')

if [ "$ml_up" = 1 ] && { [ "$APPLY_NOW" = 1 ] || [ "$cur_ml" != "$want_ml" ]; }; then
  "$DOCKER" update --cpus "$ml"  --cpuset-cpus "$CPUSET" "$ML"  >/dev/null && applied="${applied}ml=${ml} "
fi
if [ "$srv_up" = 1 ] && { [ "$APPLY_NOW" = 1 ] || [ "$cur_srv" != "$want_srv" ]; }; then
  "$DOCKER" update --cpus "$srv" --cpuset-cpus "$CPUSET" "$SRV" >/dev/null && applied="${applied}server=${srv} "
fi

echo "$ml"     > "$STATEDIR/ml_cpus"
echo "$srv"    > "$STATEDIR/srv_cpus"
echo "$streak" > "$STATEDIR/hot_streak"

# Stability, separate from heat: zram hit ~135 MiB free during the backfill,
# and immich_server has OOM-looped at a tighter mem_limit before. A near-full
# zram is an OOM risk, not a thermal one - warn before it bites.
read -r _ _ zs zu _ < <(sed -n 2p "$SWAPS")
if [ -n "${zu:-}" ] && [ -n "${zs:-}" ]; then
  zfree=$(( (zs - zu) / 1024 ))
  if [ "$zfree" -lt "$SWAP_WARN_MIB" ] && [ -x "$NTFY" ] && [ ! -f "$STATEDIR/swap-alerted" ]; then
    "$NTFY" "pihome swap nearly exhausted" \
      "zram free ${zfree} MiB. OOM killer will target immich_server next." high "warning" || true
    touch "$STATEDIR/swap-alerted"
  fi
  [ "$zfree" -ge "$SWAP_CLEAR_MIB" ] && rm -f "$STATEDIR/swap-alerted"
fi

logger -t immich-thermal-guard "temp=${temp}C hot=${HOT} profile=${prof}${ml_up:+$([ "$ml_up" = 0 ] && echo ' ml=STOPPED')}${srv_up:+$([ "$srv_up" = 0 ] && echo ' server=STOPPED')} action=${action} ml=${ml} server=${srv} ${applied:+applied: $applied}"
